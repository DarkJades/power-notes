---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { categories, resolveUrl } from '../../data/site';
import { displayFileName, resourceTypes } from '../../data/resources';

export async function getStaticPaths() {
  const entries = await getCollection('resources', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="page-main"><div class="container">
    <header class="page-title"><div class="eyebrow">{resourceTypes[entry.data.resourceType]}</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="article-meta"><span>{categories[entry.data.category]}</span><span>发布于 {entry.data.publishedAt.toISOString().slice(0, 10)}</span></div><div>{entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></header>
    <div class="resource-detail"><a class="resource-download" href={resolveUrl(entry.data.file)} download>下载资料：{displayFileName(entry.data.file)}</a><div class="prose"><Content /></div></div>
  </div></article>
</BaseLayout>
