---
import BaseLayout from './BaseLayout.astro';
import { categories, resolveUrl } from '../data/site';
const { title, description, publishedAt, updatedAt, category, tags, attachments = [] } = Astro.props;
const format = (value: Date) => new Intl.DateTimeFormat('zh-CN',{dateStyle:'long'}).format(value);
---
<BaseLayout title={title} description={description}>
  <article class="page-main">
    <div class="container">
      <header class="page-title">
        <div class="eyebrow">{categories[category as keyof typeof categories]}</div>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="article-meta"><span>发布于 {format(publishedAt)}</span>{updatedAt && <span>更新于 {format(updatedAt)}</span>}</div>
        <div>{tags.map((tag:string)=><a class="tag" href={resolveUrl(`tags/${tag}/`)}>{tag}</a>)}</div>
      </header>
      <div class="prose"><slot /></div>
      {attachments.length > 0 && (
        <section class="article-attachments" aria-label="资料附件">
          <h2>资料附件</h2>
          <ul>
            {attachments.map((attachment: string) => (
              <li><a href={resolveUrl(attachment)} target="_blank" rel="noreferrer">{attachment.split('/').at(-1)}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
  <div class="lightbox" id="figure-lightbox" role="dialog" aria-label="图片放大查看">
    <img alt="" />
  </div>
  <script>
    const diagrams = document.querySelectorAll<HTMLElement>('.mermaid');
    if (diagrams.length) {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        themeVariables: {
          primaryColor: '#fffefa',
          primaryTextColor: '#1b1a18',
          primaryBorderColor: '#985744',
          lineColor: '#706d68',
          secondaryColor: '#f3e9e3',
          tertiaryColor: '#fbfaf6',
          fontFamily: 'PingFang SC, Microsoft YaHei, sans-serif',
        },
      });
      mermaid.run({ nodes: diagrams }).catch((error) => {
        console.error('Mermaid 图表渲染失败：', error);
      });
    }

    const box = document.getElementById('figure-lightbox');
    if (box) {
      const img = box.querySelector('img');
      if (img) {
        document.querySelectorAll<HTMLImageElement>('.prose .figure img, .prose > p > img').forEach((el) => {
          el.addEventListener('click', () => {
            img.src = el.src;
            img.alt = el.alt;
            box.classList.add('is-open');
          });
        });
        const close = () => box.classList.remove('is-open');
        box.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }
    }
  </script>
</BaseLayout>
